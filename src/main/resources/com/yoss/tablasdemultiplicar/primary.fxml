<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?> 
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.yoss.tablasdemultiplicar.ActiveTabla">
   <children>
      <Label text="Tabla de:" />
      <TextField fx:id="txtTablaDe"/>
      <Button fx:id="primaryButton" text="Calcular " onAction="#calcular"/>
      <Button fx:id="limpiarButton" text="Limpiar " onAction="#limpiar"/>
      <Label fx:id="lblRes" text="" style="-fx-font-size: 20px;-fx-font-style: italic;"/>
   </children>
   <padding>
      <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
   </padding>
</VBox>
